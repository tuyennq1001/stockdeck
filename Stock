    let isEditing: Bool
    @Binding var editText: String
    let onEdit: () -> Void
    let onSave: () -> Void
    let onCancel: () -> Void
    let onDelete: () -> Void
    let onImage: () -> Void

    @State private var showPreview = false

    private static let dateFormatter: DateFormatter = {
        let f = DateFormatter()
        f.dateStyle = .medium
        f.timeStyle = .short
        return f
    }()

    var body: some View {
        VStack(alignment: .leading, spacing: 6) {
            if isEditing {
                VStack(spacing: 8) {
                    MarkdownToolbar(onInsert: { prefix, suffix in
                        editText.append(editText.isEmpty ? "\(prefix)text\(suffix)" : "\n\(prefix)text\(suffix)")
                    }, onImage: onImage)

                    if showPreview {
                        MarkdownNoteView(markdown: editText)
                            .padding(8)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .background(
                                RoundedRectangle(cornerRadius: 8, style: .continuous)
                                    .fill(DS.cardAlt)
                            )
                            .overlay(
                                RoundedRectangle(cornerRadius: 8, style: .continuous)
                                    .strokeBorder(DS.hairline, lineWidth: 1)
                            )
                    } else {
                        TextEditor(text: $editText)
                            .font(DS.body)
                            .foregroundStyle(DS.ink)
                            .scrollContentBackground(.hidden)
                            .frame(minHeight: 80)
                            .padding(8)
                            .background(
                                RoundedRectangle(cornerRadius: 8, style: .continuous)
                                    .fill(DS.cardAlt)
                            )
                            .overlay(
                                RoundedRectangle(cornerRadius: 8, style: .continuous)
                                    .strokeBorder(DS.hairline, lineWidth: 1)
                            )
                            .onDrop(of: [.fileURL, .image], isTargeted: nil) { providers in
                                for provider in providers {
                                    if provider.hasItemConformingToTypeIdentifier(UTType.image.identifier) {
                                        provider.loadDataRepresentation(forTypeIdentifier: UTType.image.identifier) { data, error in
                                            guard let data = data else { return }
                                            let filename = NoteImageStore.saveImage(data, ext: "png")
                                            DispatchQueue.main.async {
                                                editText.append("\n![image](note-image://\(filename))\n")
                                            }
                                        }
                                    }
                                }
                                return true
                            }
                    }

                    HStack(spacing: 6) {
                        Button("Save") { onSave() }
                            .buttonStyle(.plain)
                            .font(.inter(11, weight: .semibold, relativeTo: .caption))
                            .foregroundStyle(.white)
                            .padding(.horizontal, 10).padding(.vertical, 4)
                            .background(Capsule().fill(editText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? DS.inkTertiary.opacity(0.3) : DS.brand))
                            .disabled(editText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)

                        Button(showPreview ? "Edit" : "Preview") {
                            showPreview.toggle()
                        }
                        .buttonStyle(.plain)
                        .font(.inter(11, weight: .medium, relativeTo: .caption))
                        .foregroundStyle(DS.brand)
                        .padding(.horizontal, 8).padding(.vertical, 4)
                        .background(Capsule().fill(DS.brand.opacity(0.12)))

                        Spacer()

                        Button("Cancel") { onCancel() }
                            .buttonStyle(.plain)
                            .font(.inter(11, weight: .medium, relativeTo: .caption))
                            .foregroundStyle(DS.inkSecondary)
                            .padding(.horizontal, 8).padding(.vertical, 4)
                            .background(Capsule().fill(DS.cardAlt))
                    }
                }
            } else {
                HStack(alignment: .top) {
                    MarkdownNoteView(markdown: note.content)
                    Spacer(minLength: 8)
                    HStack(spacing: 2) {
                        Button(action: onEdit) {
                            Image(systemName: "pencil")
                                .font(.system(size: 10, weight: .medium))
                                .foregroundStyle(DS.inkTertiary)
                        }
                        .buttonStyle(.plain)
                        .pointingHandCursor()
                        .help("Edit note")

                        Button(action: onDelete) {
                            Image(systemName: "trash")
                                .font(.system(size: 10, weight: .medium))
                                .foregroundStyle(DS.inkTertiary)
                        }
                        .buttonStyle(.plain)
                        .pointingHandCursor()
                        .help("Delete note")
                    }
                }
            }

            HStack(spacing: 4) {
                Text("Created: \(Self.dateFormatter.string(from: note.createdAt))")
                    .font(DS.micro)
                    .foregroundStyle(DS.inkTertiary)
                if note.updatedAt != note.createdAt {
                    Text("· Edited: \(Self.dateFormatter.string(from: note.updatedAt))")
                        .font(DS.micro)
                        .foregroundStyle(DS.inkTertiary)
                }
            }
        }
        .padding(.vertical, 8)
    }
}